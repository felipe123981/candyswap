# CryptoMart Backend Configuration
PORT=3001
NODE_ENV=development
JWT_SECRET=cryptomart-dev-secret-change-in-production

# Database
DB_PATH=./server/data/cryptomart.db

# Uploads
UPLOAD_DIR=./server/uploads

# BTCPay Server (configure with your instance)
BTCPAY_URL=
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=

# FedEx API (configure with your credentials)
FEDEX_API_URL=https://apis-sandbox.fedex.com
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ACCOUNT_NUMBER=

# Pricing
DEFAULT_TAX_RATE=0.10
DEFAULT_PROFIT_MARGIN=0.20
DEFAULT_PACKAGING_COST=5.00
